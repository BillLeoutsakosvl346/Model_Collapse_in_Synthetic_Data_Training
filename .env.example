# Put real values in the local ignored .env; never commit this populated file.
# The launcher securely supplies only Runpod and Hugging Face credentials to its Pod.
RUNPOD_API_KEY=

# Optional when `hf auth login` already saved a writable token; required otherwise.
HF_TOKEN=

# Optional pre-created PRIVATE repositories, each in owner/name form.
# Scope HF_TOKEN to write to these destinations when using fine-grained access.
HF_MODEL_REPO=
HF_DATASET_REPO=
