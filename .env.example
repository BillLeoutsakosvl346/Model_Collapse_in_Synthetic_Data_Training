# Names only. Put real values privately in the Codex Cloud environment.
# A local .env file is ignored by Git and is not automatically copied to Cloud.
RUNPOD_API_KEY=

# Optional for public downloads; needed for authenticated/private artifact backup.
HF_TOKEN=

# Optional pre-created PRIVATE repositories, each in owner/name form.
# Scope HF_TOKEN to write to these destinations when using fine-grained access.
HF_MODEL_REPO=
HF_DATASET_REPO=
